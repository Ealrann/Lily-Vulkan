(ModelPart domain=org.sheepy.lily.vulkan.process.graphic.subpass name=BackgroundImage metamodels=org.sheepy.lily.core.model.Types,org.sheepy.lily.core.model.Resource,org.sheepy.lily.vulkan.model.process.Graphic,org.sheepy.lily.vulkan.model.Process,org.sheepy.lily.vulkan.model.Vulkan,org.sheepy.lily.vulkan.model.VulkanResource,org.sheepy.vulkan.model.Barrier,org.sheepy.vulkan.model.GraphicPipeline,org.sheepy.vulkan.model.Pipeline,org.sheepy.vulkan.model.Enumeration
	(Subpass name=BackgroundImage waitForStage=TRANSFER_BIT syncStage=FRAGMENT_SHADER_BIT finishStage=COLOR_ATTACHMENT_OUTPUT_BIT
		(resourcePkg)
		(descriptorPkg)

		(attachmentRefPkg
			(AttachmentRef layout=COLOR_ATTACHMENT_OPTIMAL)
			(AttachmentRef attachment=@BackgroundImageCompatibilityColorAttachment layout=SHADER_READ_ONLY_OPTIMAL type=Input))

		(attachmentPkg
			(ColorAttachment name=BackgroundImageCompatibilityColorAttachment loadOp=DONT_CARE storeOp=DONT_CARE stencilLoadOp=DONT_CARE stencilStoreOp=DONT_CARE initialLayout=TRANSFER_DST_OPTIMAL finalLayout=SHADER_READ_ONLY_OPTIMAL usages=TRANSFER_DST,INPUT_ATTACHEMENT))

		(pipelinePkg
			(Pipeline name="Blit to Swap"
					(taskPkgs stage=PRE_RENDER
						(PipelineBarrier dstStage=TRANSFER_BIT
							(ImageBarrier name="Src Image Barrier" dstLayout=TRANSFER_SRC_OPTIMAL dstAccessMask=TRANSFER_READ_BIT)
							(SwapImageBarrier dstLayout=TRANSFER_DST_OPTIMAL dstAccessMask=TRANSFER_WRITE_BIT))
						(BlitToSwapImage)))

			(Pipeline name="Blit to Image"
					(taskPkgs stage=PRE_RENDER
						(PipelineBarrier dstStage=TRANSFER_BIT
							(ImageBarrier name="Src Image Barrier" dstLayout=TRANSFER_SRC_OPTIMAL dstAccessMask=TRANSFER_READ_BIT)
							(ImageBarrier name="Color Image Barrier" dstLayout=TRANSFER_DST_OPTIMAL dstAccessMask=TRANSFER_WRITE_BIT))
						(BlitTask)))

			(GraphicsPipeline name=" Compatibility" layout=@CompatDS shaders=@BackgroundCompatVertex,@BackgroundCompatFragment
				(resourcePkg
					(Shader name=BackgroundCompatVertex stage=VERTEX_BIT
						(StringModuleResource name=background_compat.vert path=background_compat.vert.spv moduleName=org.sheepy.lily.vulkan.process.graphic))
					(Shader name=BackgroundCompatFragment stage=FRAGMENT_BIT
						(StringModuleResource name=background_compat.frag path=background_compat.frag.spv moduleName=org.sheepy.lily.vulkan.process.graphic)))

				(descriptorPkg
					(ImageDescriptor name="Compat color" type=INPUT_ATTACHMENT images=@BackgroundImageCompatibilityColorAttachment layout=SHADER_READ_ONLY_OPTIMAL shaderStages=FRAGMENT_BIT))

				(taskPkgs stage=PRE_RENDER
					(PipelineBarrier name=SwapToTransfer dstStage=TRANSFER_BIT
						(SwapImageBarrier dstLayout=TRANSFER_DST_OPTIMAL dstAccessMask=TRANSFER_WRITE_BIT)))

				(taskPkgs
					(BindDescriptorSets bindPoint=GRAPHICS descriptorSets=@CompatDS)
					(Draw vertexCount=3))

				(descriptorPool
					(descriptorSets name=CompatDS descriptors="@Compat color"))

				(StaticViewportState
					(Viewport)
					(scissors))

				(inputAssembly)
				(rasterizer)
				(colorBlend
					(attachments))
				(vertexInputState)))

		waitForAccesses=COLOR_ATTACHMENT_WRITE_BIT,TRANSFER_WRITE_BIT
		syncAccesses=INPUT_ATTACHMENT_READ_BIT
		finishAccesses=COLOR_ATTACHMENT_WRITE_BIT)
)
